{
  "_comment": "state-template.json — state.json 模板（提取自 board-protocol.md v0.1 正本）。位置：doc/specs/<spec>/board/state.json。唯一写者是 TeamLead，每次状态流转后立即写盘；worker 与 view.html 渲染页只读。state.json 只是汇总视图，任务文件与消息文件仍是事实源，冲突时以文件为准。并行增量：flow.steps[] 允许多个 running；agents[] 多个 worker 同时 working。JSON 无注释语法，_comment 键仅作说明，落地时可删除。",
  "version": 1,
  "updated": "<ISO8601>",
  "spec": "<spec 名>",
  "runtime": "<copilot-agents | kilo-task-tool | ...>",
  "flow": {
    "goal": "<总任务一句话>",
    "phase": "planning | executing | aggregating | done | blocked",
    "steps": [
      {
        "id": "step-1",
        "task": "task-001",
        "desc": "...",
        "assignee": "<agent>",
        "state": "pending | running | done | failed"
      }
    ]
  },
  "agents": [
    {
      "name": "<agent>",
      "role": "lead | worker",
      "state": "idle | working | waiting | failed",
      "detail": "..."
    }
  ],
  "tasks": [
    {
      "id": "task-001",
      "title": "...",
      "status": "open | claimed | done | failed",
      "assignee": "<agent>",
      "messages": ["msg-0001"]
    }
  ],
  "messages": [
    {
      "id": "msg-0001",
      "type": "<消息类型>",
      "from": "<agent>",
      "to": "<agent>",
      "task": "task-001",
      "ts": "<ISO8601>"
    }
  ]
}
